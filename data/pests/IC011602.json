ploadSubDirectory=/photo/sickns/&imageFileName=a7adc8a2485433bde074cac30d95004f7358fdd1416b0167b4ca40f733b6d04d0d97b0fb2bbcad63bb847c661f9b26f788e956e283b2eb240e2e0a61326d5dcafe234dbb9b0b97e48b03b12ae0114e5d","cap":"들깨_역병_줄기 피해증상2(줄기)"}]},{"code":"D00002242","kind":"병","name":"점무늬병","latin":"斑點病,Leaf spot","sections":[],"photos":[{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=eb1cfeea1806c1d8e07fa5be71ce28bfc174bdcd06c06ebf9bd3898182dae1bcd674513a4f46a5f1fd38cff3bbd12c85","cap":"점무늬병 확대_1(잎)"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=32eb3c5c18d7d3d232b41ddd0e4b39afc174bdcd06c06ebf9bd3898182dae1bc4aea6426430a39511fa577b588cc8d89","cap":"점무늬병 확대_2(잎)"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=021d00e5f7faf8bae10c2fb89df48d71c174bdcd06c06ebf9bd3898182dae1bcf197d690c4507dd23715c82c84a12ee8","cap":"점무늬병 확대_6(잎)"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=67f808d5b8cfa0be2e759f0b764d39b407dda5b5488157e6d99e598f4867e7f5c03a601d622941aba10e148a2c6c14b5fe234dbb9b0b97e48b03b12ae0114e5d","cap":"점무늬병 병징_1(잎)"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=67f808d5b8cfa0be2e759f0b764d39b467739f139fae25de872d7023e5b2e1a68abe32d43329d943162aa4abdd46c47afe234dbb9b0b97e48b03b12ae0114e5d","cap":"점무늬병 병징_2(잎)"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/sickns/&imageFileName=67f808d5b8cfa0be2e759f0b764d39b473fe1f5146e39e54432700bdd2fed9d3c50f7d84e1a070df08cb7f3f7ddabe4ffe234dbb9b0b97e48b03b12ae0114e5d","cap":"점무늬병 병징_4(잎)"}]},{"code":"H00000416","kind":"해충","name":"도둑나방","latin":"brassicae","sections":[["대상작물","들깨"],["목/과명","나비목/밤나방과"],["속명","Mamestra"],["생태정보","연 2회 발생하며, 번데기로 겨울을 난다.\n1회 성충은 4~6월에 2회 성충은 8~9월에 나타난다.\n유충기간은 40~45일이다.\n성충은 해질 무렵부터 활동을 시작하며 낮에는 마른 잎 사이에 숨는다.\n3령까지는 무리지어 가해하다가 4령 이후 분산하여 생활하고, 땅속에서 번데기가 된다.\n예찰은 페로몬을 이용하여 할 수 있다.\n해질 무렵에 집단으로 배추나 양배추 잎으로 올라와 잎을 갉아먹는 유충을 찾는다."],["피해정보","잡식성이어서 10여종의 기주가 알려져 있고, 채소, 화훼 등 원예작물의 대해충으로 알려져있다.\n봄, 가을에 피해가 심하고, 결구배추의 속으로 파고 들어가며 식해하기도 한다."],["방제방법","유충이 자라면 내성이 커지기 때문에 발생 초기에 친환경자재를 이용해 방제해야 한다."]],"photos":[{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=7c77fb30dd20fa04f53ed73266a92551c1148bf3756399dcc24a1751ea29c3af5fba721fb969d860ae628a47896106aa02c32c9a2b851aaac9a28c4e2ec07211","cap":"도둑나방 피해(잎)"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=7c77fb30dd20fa04f53ed73266a925519a777faf378c7cca0a85ec56edc5110d81f56758836ec1c837ddcc26f44cf4297facc6063a77b0a3395279e7b7096342","cap":"도둑나방 피해(잎)"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=43f7da23a357cc27aaeb2fb6205fbbc6fb7e861b96552b8caa1883719fc0bce704841ce92ce8b428e660added6811e010c4ea910f7994cae28600708efddca2b7b2dcd1393a2735874fcdef26fa5d78f","cap":"도둑나방 알"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=8d9426a31dc63b975186cf5f1c0f6e3b77221afa4ff2329509a4e0b8b0869e1df89f15cbeef0b3100fadbc0267ebdf1274c43d143343c10a62124e8c85a3ac37","cap":"도둑나방"}]},{"code":"H00000434","kind":"해충","name":"파밤나방","latin":"exigua","sections":[["대상작물","들깨"],["목/과명","나비목/밤나방과"],["속명","Spodoptera"],["생태정보","고온성 해충으로 성충이 5월부터 나타나기 시작하여 10월까지 발생한다.\n8월 하순부터 10월 하순에 성충발생이 많으며, 이때를 전후하여 피해도 많이 발생하며 11월까지도 피해가 나타난다.\n성충의 산란기간은 5~8일, 알 기간은 2~5일, 유충기간은 9~23일, 번데기 기간은 5~14일이다.\n암컷은 난괴로 1,000개의 알을 낳는다.\n다자란 유충은 35㎜ 정도이며, 황록색~흑갈색으로 체색변이가 심하지만 보통은 녹색인 것이 많다.\n콩, 완두, 무, 파, 양파, 감자, 토마토, 고구마 등을 가해하며 1988년 8월 전남 해남, 무안, 진도 등지의 지황, 배추, 파, 대파 등에 큰 피해를 주었다.\n발생량은 전남, 경남, 제주 등 주로 남쪽지역에 많으나 중부이북 지역에서도 해에 따라 발생량이 많다.\n노지에서 1년에 4~5회 발생하며 제주도 및 남부 해안지역의 따뜻한 지역에서는 1회 이상 더 발생할 수 있다.\n예찰은 페로몬 트랩을 설치하여 발생예찰을 할 수 있다."],["피해정보","유충은 잡식성으로 채소, 화훼류, 전작물 등을 널리 가해한다.\n파에서는 잎 속으로 들어가 안에서 가해하며, 결구 식물에서는 결구 속으로 파고 들어가 피해를 주고, 그 외 작물은 잎을 가해한다.\n2~3령까지는 집단으로 가해하고 그 후에는 분산하여 가해한다."],["방제방법","농약에 저항성이 잘 생겨 방제하기 쉽지 않은 해충이며, 비교적 1~2령의 어린 유충기간에는 방제 효과가 높으나. 3령 이후의 큰 유충이 되면 방제효과가 떨어진다.\n발생 초기 등록된 약제를 이용해 방제한다."]],"photos":[{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=1df563d00a16db8f72911bd131771bc92be4b1071ccfdcf96b502e91b403d0bc7fe9694ef36e35a93d35660a7a0bb86b02c32c9a2b851aaac9a28c4e2ec07211","cap":"파밤나방 피해(잎)"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=1df563d00a16db8f72911bd131771bc99a777faf378c7cca0a85ec56edc5110d71ba88995e66100f3d682e592af734bb7facc6063a77b0a3395279e7b7096342","cap":"파밤나방 피해(잎)"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=1df563d00a16db8f72911bd131771bc963452b5c5eb234c982a46c4beb351362404ebf025078dbfdfeb5c4154dd3f3c57facc6063a77b0a3395279e7b7096342","cap":"파밤나방 피해(잎)"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=1df563d00a16db8f72911bd131771bc9ef3be2acde97a867c65549ba9375b90f7e527bdb30e5e71c2d0c144758b12aecff8ed5765362353387e4ee801c3515e5","cap":"파밤나방 피해와 유충(잎)"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=337e541925b4ea5f3f8928d089320e15eedc3f3e9dee3a93091e4f8cc2de04c49d7dee8e954fad1ac941399a4ca07c69a00e34a33479f3eae7d59ab0d1929cd1","cap":"파밤나방 유충"}]},{"code":"H00000799","kind":"해충","name":"들깨잎말이명나방","latin":"panopealis","sections":[["대상작물","들깨"],["목/과명","나비목/명나방과"],["속명","Pyrausta"],["생태정보","들깨잎말이명나방의 발생은 자세히 밝혀지지 않았으나, 대체로 연 3～4회 발생하는 것으로 추정된다.\n노지재배 들깨에는 5월에서 9월까지 발생하는데 8월과 9월에 최성기를 보인다.\n월동은 4령 유충으로 피해 받은 작물의 잎이나 가지 속에서 한다.\n월동 유충은 피해 잎에서 겨울을 보내고 다음 해 5～6월 휴면에서 깨어나 다시 가해하고, 6월 하순경 번데기로 된다.\n7월에 2세대가 발생하고 8월말부터 9월초까지 3세대가 발생하는 것으로 보인다.\n발육기간은 25℃에서 알기간 3.8일, 유충기간 12.8일(1～5령), 번데기 9.6일로 1세대가 26.2일이 소요된다."],["피해정보","들깨잎말이명나방은 유충이 피해를 주며, 들깨, 차즈기(자소) 같은 향료식물을 가해하여 기주범위가 매우 좁아 해충으로서 크게 인식되지 못하였으나, 남부 지역인 밀양, 부산 등지에서 시설재배 들깨가 확대되면서 월동 및 증식이 유리해져 발생밀도가 크게 높아졌다.\n유충은 들깨 잎의 어린 순이나 잎을 주로 가해하는데, 피해 받은 잎은 구멍이 뚫린다.\n특히, 새순 부근의 잎과 줄기를 꺾어 놓고 실을 토해 잎을 말아서 그 속에서 가해하며 피해 받은 줄기는 성장이 더디다."],["방제방법","주말농장 소규모 재배지에서는 들깨 상단부의 피해부위를 육안으로 살펴보면 줄기가 꺾여있거나 말린 잎을 채취하여 비닐 지퍼팩 등에 넣어 밀폐하여 죽이는 방법이 있다.\n농약사용은 작물보호제 지침서의 해당 작물의 전용약제를 사용하는데, 유충이 잎을 말고 있어 약제가 해충의 몸에 묻지 않을 수 있으므로 피해부위 위주로 흠뻑 살포해야 한다."]],"photos":[{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=5d8017d07b57dea32e3e1b09f83e7e03dc35925e2c1393afff6f3389c94e227231cb6d7679e94d35b5c900e0ea5f587ca03006128839e4caac99bb7372dc6628fe234dbb9b0b97e48b03b12ae0114e5d","cap":"들깨잎말이명나방 피해(들깨)(잎)"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=eb248a5b86e32d91f7120cb23df6117ceedc3f3e9dee3a93091e4f8cc2de04c44bee1e0cf92525a092c8765a4d471de0d40cfaf25078187c45dad0f82e9dd52e","cap":"들깨잎말이명나방 유충"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=8beba872cda1356eed0014faaa7f49eeeedc3f3e9dee3a93091e4f8cc2de04c44bee1e0cf92525a092c8765a4d471de07b2dcd1393a2735874fcdef26fa5d78f","cap":"들깨잎말이명나방 번데기"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=35366d60eb77b8ad2472be94e69a5f50eedc3f3e9dee3a93091e4f8cc2de04c4d2c8837d508abd79366d2d83eae4258ae0f8565a7fb33b8cae008c282b7895b9","cap":"들깨잎말이명나방 성충"}]},{"code":"H00000373","kind":"해충","name":"벼룩잎벌레","latin":"striolata","sections":[["대상작물","들깨"],["목/과명","딱정벌레목/잎벌레과"],["속명","Phyllotreta"],["생태정보","벼룩잎벌레는 배추, 무, 양배추 등 십자화과 작물의 어린 유묘를 가해하여 피해를 주는 해충으로 전국적으로 발생한다.\n성충으로 월동하고 연 3~5회 발생한다.\n낙엽, 풀뿌리, 흙덩이 틈에서 월동한 성충은 3월 중하순부터 출현한다.\n4월에 성충이 작물의 뿌리나 얕은 흙속에 1개씩 산란하여 30여 일간 한마리가 150~200개를 낳는다.\n성충은 5~6월에 증가하며, 여름철에 다소 줄어든다.\n예찰은 구멍이 뚫린 어린잎 주위를 살펴보면 톡톡튀는 흑색 바탕에 황색 세로 무늬가 있는 작은 벌레를 찾을 수 있다."],["피해정보","성충은 십자화과 작물, 사탕무 등의 잎을 갉아먹는다.\n묘에 피해가 많고, 갉아먹은 구멍은 생육하면서 커진다.\n유충은 땅속에서 무나 순무의 뿌리 표면을 불규칙하게 먹고, 흑부병을 유발하는 원인이 기도 한다.\n늦은 봄부터 여름까지 피해가 심하다."],["방제방법","들깨 생육 초기에 피해가 크므로 초기 방제가 중요하다.\n파종 전에 경운이나 담수처리하여 땅속의 유충을 방제하고, 파종 후나 정식 후에는 친환경자재를 이용해 방제한다."]],"photos":[{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=32aa90323d053a601f9ab59d0c59446f1c5db664c7234664121abe0faa1711f804687ab1d85824b64f2928cc04666cf8f8fd6eec2b488d7bb904251fe46ceb25","cap":"벼룩잎벌레 들깨 피해(잎)"}]},{"code":"H00000516","kind":"해충","name":"차먼지응애","latin":"latus","sections":[["대상작물","들깨"],["목/과명","응애/먼지응애과"],["속명","Polyphagotarsonemus"],["생태정보","시설하우스 내 채소, 화훼작물과 노지의 가지 등에서 피해가 많이 발생했다.\n차먼지응애의 발육단계는 알, 약충, 정지기(휴지기)약충, 성충의 4단계를 거친다.\n차먼지응애는 고사한 잎이나 그루터기 등에서 집단으로 월동을 한다.\n따뜻한 온실에서는 연중 발생이 가능하며 25℃ 이상의 고온에서는 사망률이 높고 산란율이 떨어져 여름철에는 발생량이 적다.\n알에서 성충이 될 때까지의 발육기간은 15℃에서 15～16일 정도 소요되지만 20℃와 25℃에서는 각각 4.5일, 3.5일로 급격히 빨라진다.\n온실이나 비닐하우스 내에서는 월 6세대 이상 경과할 수 있다.\n발육적온은 15～20℃로서 차먼지응애의 발생 시기는 노지에서 5～6월, 9∼10월 사이이다.\n예찰은 생장점 부근이 말리는 등 기형으로 되어 작물이 크지 못하고 광택이 나며, 식물체가 프라스틱과 같이 빳빳해 지면 의심을 하고 피해 부위를 채취하여 해부 현미경에서 발생여부를 확인한다."],["피해정보","차먼지응애는 대부분 생장점 부근의 전개 직후의 어린잎과 어린 과일을 선호하여 가해한다.\n초기에는 생장점부위의 어린잎에 주름이 생기고 잎의 가장자리가 안쪽으로 오그라들며, 기형이 된다.\n심하게 피해를 받으면 생장점에서 새로운 잎이 나오지 않아 피해 받은 주(株)는 성장하지 못한다.\n주로 잎 뒷면에 기생하므로 잎이 뒤쪽으로 말려 기형이 된다.\n피해 받은 잎의 뒷면은 기름을 바른 듯이 광택이 나며, 갈색으로 변하면서 딱딱하게 경화(코르크화)되어 있다.\n피해를 받은 어린잎은 건드리면 쉽게 부러지므로 일명 플라스틱병이라고도 한다."],["방제방법","생장점 부위를 집중적으로 가해하므로 순 부위의 어린 잎에 피해가 나타나는 초기에 친환경자재를 이용해 방제해야 한다.\n차먼지응애는 크기가 워낙 작아 육안으로 관찰이 어렵다.\n작물에 피해가 나고서야 발견하는 경우가 대부분이다.\n주로 시설재배지에 발생이 많고 노지에서는 빗물과 건조로 인하여 발생이 많지 않다.\n피해가 보이면 작물보호제 지침서의 전용농약을 생장점 부근 위주로 살포한다.\n여름에 기온이 상승하면 발생량이 많이 줄어든다."]],"photos":[{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=199e59d7df734ec6bbf06faed3ded0f93a1421c3a546ca0e45c832a7dcd381dd5e04eed92a2959f297f0e4d448719e764e5a63a7e8709d540b56669410c052a9badaeb3d27d1d3f937f29313eb76fb6a","cap":"차먼지응애 들깨 잎 피해(좌측 정상)(잎)"}]},{"code":"H00000257","kind":"해충","name":"섬서구메뚜기","latin":"lata","sections":[["대상작물","들깨"],["목/과명","메뚜기목/섬서구메뚜기과"],["속명","Atractomorpha"],["생태정보","방아개비와 비슷하지만 몸이 뭉툭해 보이고 훨씬 짧다.\n예찰은 잎을 들추어보거나 작물체를 털어서 약충과 성충의 발생을 육안으로 확인한다.\n연 1회 발생하며 알로 월동하는데, 월동한 알은 5월 하순∼6월 상순에 부화하고 약충은 식물체를 갉아 먹으며 성장하며 몇 차례 탈피한 후 8∼9월에 성충이 된다.\n성충은 짝짖기를 한 후 깊이 2㎝정도 되는 땅속에 알을 낳는다.\n고온 건조한 해에 발생이 많은 경향이며, 어린 약충은 섭식량이 적지만 다자란 약충과 성충은 잎을 폭식한다."],["피해정보","잡식성으로 약충과 성충이 주로 잎을 가해한다.\n피해를 받은 잎은 불규칙한 구멍이 생기며, 발생이 심한 경우 줄기만 남기고 모두 먹어 치운다.\n8∼9월경에 야산이나 잡초가 많은 근처의 포장에 많이 발생한다."],["방제방법","대규모 작물을 재배하는 일반농가의 경우 잎을 폭식하므로 발생이 많으면 약제를 살포해야 하나, 도시 주말농장은 재배면적이 작고 다양한 작물이 재배되고 있어 약제를 살포하여도 옆 포장으로 이동하여 방제가 어려우므로 보이는 즉시 손으로 잡아 죽이는 방법이 좋다."]],"photos":[{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=71f7bc1818d5d1db276744e8f28ff32dcb1b6fe060c68709098b7862b48c1d7871523f9e89368ff2c84a7fad1b98ae0a454b21aed06001de927262e9c5773a8c02c32c9a2b851aaac9a28c4e2ec07211","cap":"섬서구메뚜기 피해와 성충(잎)"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=71f7bc1818d5d1db276744e8f28ff32d822ff7a954ab98c96511c068484774cfa1fdd94e3c18d2629a3ff29094a0436b83e622d9d01fc57c50f8d93b647b7b1d","cap":"섬서구메뚜기 피해(잎)"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=71f7bc1818d5d1db276744e8f28ff32d822ff7a954ab98c96511c068484774cf58fb02e23110f2aafd8eb1597f54cf87ac9bf43c48a64f3e6cdf6dfb0a69f4b0","cap":"섬서구메뚜기 피해(잎)"}]},{"code":"H00000401","kind":"해충","name":"왕담배나방","latin":"armigera","sections":[["대상작물","들깨"],["목/과명","나비목/밤나방과"],["속명","Helicoverpa"],["생태정보","년간 발생세대수는 2∼3세대로 번데기 상태로 땅속에서 지낸 후 5∼6월에 우화하여 10월까지 피해를 준다.\n알은 잎당 1개씩 산발적으로 낳지만 때로 5∼10개를 집단으로 낳기도 하며, 500개 내외의 알을 낳는다.\n산란∼부화까지의 기간은 실온에서 약 3∼4일, 알∼우화까지는 17∼20일 정도가 소요되며, 유충기간은 25℃에서 19~26일 정도이며, 다자란 유충은 땅속 2~10㎝ 깊이에서 번데기가 된다.\n성충 수명은 10∼12일이다.\n예찰은 페로몬 트랩을 설치하여 실시한다.\n피해식물이나 유충의 배설물을 관찰하여 발생을 확인할 수 있다."],["피해정보","해충은 광식성으로 채소, 과수, 화훼류에 널리 가해한다.\n담배, 감자, 목화, 콩, 녹두, 땅콩, 토마토 등의 꽃잎이나 새잎을 가해하며, 감귤원에서는 5∼9월에 주로 새순의 잎을 갉아먹으며 과실에서는 유과기로부터 수확 시까지 과실에 구멍을 뚫으면서 먹는다."],["방제방법","발생후 줄기속으로 들어가면 방제가 곤란하므로 조기발견이 중요하다.\n어린유충기에 친환경자재를 이용해 방제해야 한다.\n성충은 알을 새잎이나 신초에 산란하므로 적심한 신초나 잎은 수거하여 외부에 버리거나 태워야 한다."]],"photos":[{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=4b048529588a5e491365080e37938f6de1c55dccdfe776a88e35732bb58d41cccfc87157ca26cb4a0fa63a286a4d71a5c6f8458abebe6c8fdebe3f1b54d4ed10fe234dbb9b0b97e48b03b12ae0114e5d","cap":"왕담배나방 피해와 유충(잎)"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=4b048529588a5e491365080e37938f6de1c55dccdfe776a88e35732bb58d41cca1ac06100888eeb19ec0bef636218133fffa43be791aefa40b7179a945ae8bca6d049319a462d87d12fcb28d9440e618","cap":"왕담배나방 피해와 유충(잎)"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=4b048529588a5e491365080e37938f6de1c55dccdfe776a88e35732bb58d41cc607068b58b7e3b64d8f043488b45df354d92a60da386c35729e82176890360666d049319a462d87d12fcb28d9440e618","cap":"왕담배나방 피해와 유충(잎)"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=4b048529588a5e491365080e37938f6de1c55dccdfe776a88e35732bb58d41cc6846ebb25030e1ca7d8227d79831f09b3f2f844bf51885369d86f56091556ef76d049319a462d87d12fcb28d9440e618","cap":"왕담배나방 피해와 유충(잎)"}]},{"code":"H00000519","kind":"해충","name":"점박이응애","latin":"urticae","sections":[["대상작물","들깨"],["목/과명","응애/잎응애과"],["속명","Tetranychus"],["생태정보","온도가 높은 시설재배 작물에서 발생이 많다.\n점박이응애는 추운 지방에서는 년 9회, 따뜻한 지방에서는 10~11회 발생하고, 성충으로 월동한다.\n시설작물에서는 가온하고 야간 조명을 하면 휴면하지 않는다.\n월동한 성충은 처음에는 잡초에서 번식하다가 작물이 생육함에 따라 작물로 이동하여 발생하며, 8월이 가해최성기이다.\n잎의 표면과 뒷면 양쪽 모두를 가해하나 주로 잎 뒷면에서 주로 서식한다.\n발육시작온도는 9℃전후이고, 발육적온은 20~28℃, 최적습도는 50~80%로서, 25℃에서 알에서 성충까지 10일이 소요되는데 좋은 환경조건에서는 급속히 개체수가 증가한다.\n예찰은 식물체 뒷면을 육안 또는 확대경을 이용하여 조사한다.\n점박이응애의 피해를 받으면 잎 표면에 흰 반점이 나타나므로 이 반점의 유무를 확인하여 발생여부를 확인 할 수도 있다."],["피해정보","잎 뒷면에서 세포 내용물을 빨아먹으므로 잎 표면에 작은 흰 반점이 무더기로 나타나고 심하면 잎이 말라죽는다.\n작은 반점은 초기에는 연녹색으로 변색되다가 점차 황색~갈색으로 변하고 심하면서 낙엽이 진다.\n밀도가 높아지면 상부로 올라와 피해를 주며, 피해 부위에 가느다란 거미줄을 친다."],["방제방법","작물의 하위 잎에서 발생이 시작하여 새잎으로 확산된다.점박이응애 발생초기에는 물을 뿌리는 것도 도움이 되나 등록된 살비제를 살포 하는 것이 안전하다."]],"photos":[{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=85747f33a72d083015967dc790d2849d7cdeaeb22a7236adb2e2496aa9f08bc47a62e495bdb0f49fcaacd64cdfd4183a","cap":"점박이응애 들깨 피해(잎)"},{"src":"https://ncpms.rda.go.kr/npmsAPI/thumbnailViewer2.mo?uploadSpec=npms&uploadSubDirectory=/photo/hlsct/&imageFileName=ebf82e3afbb399be5a7e612d966fb27a48ca240161ec80370f07cdab72872637cfc87157ca26cb4a0fa63a286a4d71a50a21038168606b67467ee0ff5bcf63f1fe234dbb9b0b97e48b03b12ae0114e5d","cap":"점박이응애 들깨 피해흔(잎)"}]}]}