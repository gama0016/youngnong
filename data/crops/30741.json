        {
          "label": "씨앗 관리",
          "value": "채종 후 약 120일 휴면기간이 지난 뒤 2~5℃에서 7일간 저온처리하거나, 채종 후 노천매장하여 씨뿌림"
        },
        {
          "label": "파종 방법",
          "value": "흩뿌림 또는 10cm 간격 줄뿌림"
        },
        {
          "label": "복토",
          "value": "부드러운 토양을 5~10mm 두께로 덮기"
        },
        {
          "label": "발아율 향상",
          "value": "짚 또는 건초 덮기"
        }
      ]
    },
