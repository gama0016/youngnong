  "stages": [
    {
      "title": "씨뿌림",
      "timing": "평지 3~4월 / 난지 2~3월",
      "items": [
        {
          "label": "육묘",
          "value": "전열온상, 32공 플러그트레이(난지는 12cm 흑색비닐포트도 사용)"
        },
        {
          "label": "씨앗양(노지재배)",
          "value": "3㎗/10a(1㎗ ≈ 220립)"
        },
        {
          "label": "씨앗양(비가림 입체재배)",
          "value": "8.5㎗/10a"
        },
        {
          "label": "모 기르기 일수",
          "value": "억제 20일(2.5엽), 촉성 및 노지 30~40일(4~5엽), 반촉성 및 조숙 45일(5.5엽)"
        }
      ]
    },
    {
      "title": "아주심기",
      "timing": "노지 4~5월 / 노지 터널 3~4월",
      "items": [
        {
          "label": "2줄기 유인 노지재배",
          "value": "300×60cm(600주/10a)"
        },
        {
          "label": "비가림 입체재배",
          "value": "150×40cm(1,600주/10a)"
        },
        {
          "label": "묘 순화",
          "value": "아주심기 10일 전부터 주간 18℃, 야간 9~10℃, 물주기 줄임"
        },
        {
          "label": "지온",
          "value": "비닐멀칭으로 최저지온 12℃ 이상 확보"
        },
        {
          "label": "터널 제거",
          "value": "외기 최저온도 11℃ 이상이면 완전히 제거"
        }
      ]
    },
    {
      "title": "유인·정지·수분",
      "timing": null,
      "items": [
        {
          "label": "잎 수",
          "value": "1과당 적정 잎 수 약 15매"
        },
        {
          "label": "유인방법",
          "value": "원줄기, 2줄기, 3줄기 재배, 입체유인(L자 유인) 등"
        },
        {
          "label": "인공수분",
          "value": "가급적 오전 8시 이전"
        },
        {
          "label": "적과",
          "value": "열매 달린 마디 아래의 곁가지와 열매를 미리 솎음"
        }
      ]
    },
    {
      "title": "수확",
