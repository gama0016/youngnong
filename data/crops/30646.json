  "stages": [
    {
      "title": "씨뿌림·모 기르기",
      "timing": "아주심기일 기준으로 결정",
      "items": [
        {
          "label": "육묘 기간",
          "value": "억제 40~50일, 조숙·비가림 50~60일, 촉성·반촉성 55~65일"
        },
        {
          "label": "좋은 묘",
          "value": "줄기 굵기 0.8~1.0cm, 제1화방에 충실한 꽃, 잎이 두껍고 진녹색"
        }
      ]
    },
    {
      "title": "본포 준비",
      "timing": "아주심기 15~20일 전 ~ 7~10일 전",
